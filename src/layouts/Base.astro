---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <script is:inline>
      // Always open a page at the top (unless the link points to a section), instead of
      // the browser restoring the last scroll position on reload.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!location.hash) window.scrollTo(0, 0);
    </script>
    <header class="top">
      <div class="wrap top__inner">
        <a href="/" class="top__name">Jefrey Jurado</a>
        <nav aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>About</a>
          <a href="/work/" aria-current={path.startsWith('/work') ? 'page' : undefined}>Work</a>
          <a href={site.resume} target="_blank">Résumé</a>
          <a href={`mailto:${site.email}`}>Email</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap footer" id="contact">
      <div class="contact">
        <div class="contact__text">
          <p class="contact__tag">Let's talk</p>
          <p class="contact__lead">Open to full-time roles and freelance projects.</p>
          <p class="contact__sub">Based in {site.location} · willing to relocate</p>
        </div>
        <div class="contact__actions">
          <a href={`mailto:${site.email}`} class="contact__email">
            <span class="contact__label">Email me</span>
            <span class="contact__address">{site.email}</span>
            <span class="contact__arrow" aria-hidden="true">↗</span>
          </a>
          <div class="contact__links">
            <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href={site.resume} target="_blank">Résumé (PDF) ↗</a>
          </div>
        </div>
      </div>
      <div class="footer__row muted">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>Graphic Designer &amp; Layout Artist</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(242, 242, 242, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .top__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: 64px;
  }

  .top__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    font-size: 15px;
  }

  nav a {
    color: var(--muted);
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 420px) {
    nav {
      gap: 14px;
      font-size: 14px;
    }
  }

  .footer {
    margin-top: clamp(56px, 7vw, 88px);
    padding-bottom: 28px;
  }

  /* Contact card in the same maroon gradient as the home page hero */
  .contact {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    padding: clamp(32px, 4.5vw, 64px);
    border-radius: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(242, 242, 242, 0.12), transparent 55%),
      linear-gradient(135deg, var(--maroon) 0%, var(--wine) 100%);
    color: var(--light);
    box-shadow: 0 30px 60px -36px rgba(115, 3, 13, 0.6);
  }

  .contact__tag {
    display: inline-block;
    padding: 5px 14px;
    border: 1px solid rgba(242, 242, 242, 0.35);
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.85);
  }

  .contact__lead {
    margin-top: 18px;
    font-size: clamp(28px, 3.2vw, 46px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .contact__sub {
    margin-top: 12px;
    font-size: 16px;
    color: rgba(242, 242, 242, 0.78);
  }

  .contact__actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact__email {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 64px 22px 24px;
    background: var(--light);
    border-radius: 18px;
    color: var(--ink);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .contact__email:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -22px rgba(13, 13, 13, 0.6);
  }

  .contact__label {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact__address {
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--maroon);
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    position: absolute;
    top: 50%;
    right: 20px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    border-radius: 50%;
    background: var(--maroon);
    color: var(--light);
    font-size: 16px;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact__links a {
    padding: 10px 18px;
    border: 1px solid rgba(242, 242, 242, 0.45);
    border-radius: 999px;
    font-size: 15px;
    transition: background 0.2s, border-color 0.2s;
  }

  .contact__links a:hover {
    background: rgba(242, 242, 242, 0.14);
    border-color: var(--light);
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .footer__row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 24px;
    padding: 0 4px;
    font-size: 14px;
  }
</style>
