---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const path = Astro.url.pathname;
// Absolute URLs for link previews; falls back to the request URL if `site` isn't configured.
const origin = Astro.site ?? Astro.url;
const pageUrl = new URL(path, origin).href;
const ogImage = new URL('/og.jpg', origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jefrey Jurado — Graphic Designer & Layout Artist portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <script is:inline>
      // Always open a page at the top (unless the link points to a section), instead of
      // the browser restoring the last scroll position on reload.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!location.hash) window.scrollTo(0, 0);
    </script>
    <header class="top">
      <div class="wrap top__inner">
        <a href="/" class="top__name">Jefrey Jurado</a>
        <nav aria-label="Main">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>About</a>
          <a href="/work/" aria-current={path.startsWith('/work') ? 'page' : undefined}>Work</a>
          <a href={site.resume} target="_blank">Résumé</a>
          <a href={`mailto:${site.email}`}>Email</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap footer" id="contact">
      <div class="contact">
        <div class="contact__text">
          <p class="contact__tag">Let's talk</p>
          <p class="contact__lead">Open to full-time roles and freelance projects.</p>
          <p class="contact__sub">Based in {site.location} · willing to relocate</p>
        </div>
        <div class="contact__actions">
          <a href={`mailto:${site.email}`} class="contact__email">
            <span class="contact__label">Email me</span>
            <span class="contact__address">{site.email}</span>
            <span class="contact__arrow" aria-hidden="true">↗</span>
          </a>
          <div class="contact__links">
            <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
            <a href={site.resume} target="_blank">Résumé (PDF) ↗</a>
          </div>
        </div>
      </div>
      <div class="footer__row muted">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>Graphic Designer &amp; Layout Artist</span>
      </div>
    </footer>

    <!-- Shown when an email link is clicked: many visitors have no desktop mail app, so mailto alone can do nothing. -->
    <div class="mailtoast" role="status" aria-live="polite" hidden>
      <p class="mailtoast__text">
        <span class="mailtoast__check" aria-hidden="true">✓</span>
        <span>Email copied: <strong>{site.email}</strong></span>
      </p>
      <div class="mailtoast__actions">
        <a
          href={`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}`}
          target="_blank"
          rel="noopener"
          class="mailtoast__primary">Open Gmail ↗</a
        >
        <a href={`mailto:${site.email}`} data-mail-app>Use email app</a>
        <button type="button" class="mailtoast__close" aria-label="Close">✕</button>
      </div>
    </div>

    <script>
      const toast = document.querySelector<HTMLElement>('.mailtoast');
      let hideTimer: number | undefined;

      const hide = () => {
        if (toast) toast.hidden = true;
      };

      document.addEventListener('click', async (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="mailto:"]');
        if (!link || !toast || link.hasAttribute('data-mail-app')) return;
        e.preventDefault();
        const address = link.href.replace(/^mailto:/, '').split('?')[0];
        try {
          await navigator.clipboard.writeText(address);
        } catch {
          // Clipboard can be blocked; the toast still shows the address and the Gmail / mail-app options.
        }
        toast.hidden = false;
        window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(hide, 8000);
      });

      toast?.querySelector('.mailtoast__close')?.addEventListener('click', hide);
      toast?.querySelectorAll('a').forEach((a) => a.addEventListener('click', hide));
    </script>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(242, 242, 242, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .top__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: 64px;
  }

  .top__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    font-size: 15px;
  }

  nav a {
    color: var(--muted);
    transition: color 0.2s;
  }

  nav a:hover {
    color: var(--accent);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 420px) {
    nav {
      gap: 14px;
      font-size: 14px;
    }
  }

  .footer {
    margin-top: clamp(56px, 7vw, 88px);
    padding-bottom: 28px;
  }

  /* Contact card in the same maroon gradient as the home page hero */
  .contact {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    padding: clamp(32px, 4.5vw, 64px);
    border-radius: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(242, 242, 242, 0.12), transparent 55%),
      linear-gradient(135deg, var(--maroon) 0%, var(--wine) 100%);
    color: var(--light);
    box-shadow: 0 30px 60px -36px rgba(115, 3, 13, 0.6);
  }

  .contact__tag {
    display: inline-block;
    padding: 5px 14px;
    border: 1px solid rgba(242, 242, 242, 0.35);
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.85);
  }

  .contact__lead {
    margin-top: 18px;
    font-size: clamp(28px, 3.2vw, 46px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .contact__sub {
    margin-top: 12px;
    font-size: 16px;
    color: rgba(242, 242, 242, 0.78);
  }

  .contact__actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .contact__email {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 64px 22px 24px;
    background: var(--light);
    border-radius: 18px;
    color: var(--ink);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .contact__email:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px -22px rgba(13, 13, 13, 0.6);
  }

  .contact__label {
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .contact__address {
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--maroon);
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    position: absolute;
    top: 50%;
    right: 20px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-top: -18px;
    border-radius: 50%;
    background: var(--maroon);
    color: var(--light);
    font-size: 16px;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .contact__links a {
    padding: 10px 18px;
    border: 1px solid rgba(242, 242, 242, 0.45);
    border-radius: 999px;
    font-size: 15px;
    transition: background 0.2s, border-color 0.2s;
  }

  .contact__links a:hover {
    background: rgba(242, 242, 242, 0.14);
    border-color: var(--light);
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .footer__row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 24px;
    padding: 0 4px;
    font-size: 14px;
  }

  .mailtoast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    z-index: 50;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 20px;
    width: max-content;
    max-width: calc(100vw - 32px);
    padding: 14px 14px 14px 20px;
    border-radius: 18px;
    background: var(--black);
    color: var(--light);
    box-shadow: 0 24px 50px -20px rgba(0, 0, 0, 0.5);
    transform: translateX(-50%);
    animation: toast-in 0.25s ease-out;
  }

  .mailtoast[hidden] {
    display: none;
  }

  @keyframes toast-in {
    from {
      opacity: 0;
      transform: translate(-50%, 10px);
    }
  }

  .mailtoast__text {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    overflow-wrap: anywhere;
  }

  .mailtoast__check {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--maroon);
    font-size: 13px;
  }

  .mailtoast__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .mailtoast__actions a {
    padding: 8px 14px;
    border: 1px solid rgba(242, 242, 242, 0.3);
    border-radius: 999px;
    font-size: 14px;
    white-space: nowrap;
    transition: background 0.2s;
  }

  .mailtoast__actions a:hover {
    background: rgba(242, 242, 242, 0.12);
  }

  .mailtoast__actions .mailtoast__primary {
    background: var(--light);
    border-color: var(--light);
    color: var(--maroon);
  }

  .mailtoast__actions .mailtoast__primary:hover {
    background: #ffffff;
  }

  .mailtoast__close {
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: rgba(242, 242, 242, 0.7);
    font: inherit;
    cursor: pointer;
  }

  .mailtoast__close:hover {
    background: rgba(242, 242, 242, 0.12);
    color: var(--light);
  }
</style>
