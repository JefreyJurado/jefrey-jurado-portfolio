---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="top">
      <div class="wrap top__inner">
        <a href="/" class="top__name">Jefrey Jurado</a>
        <nav aria-label="Main">
          <a href="/#work" aria-current={path === '/' ? 'page' : undefined}>Work</a>
          <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
          <a href={site.resume} target="_blank">Résumé</a>
          <a href={`mailto:${site.email}`}>Email</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap footer" id="contact">
      <div class="footer__main">
        <p class="footer__lead">Open to full-time roles and freelance projects.</p>
        <a href={`mailto:${site.email}`} class="footer__email link">{site.email}</a>
      </div>
      <div class="footer__row muted">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>{site.location}</span>
        <a href={site.linkedin} class="link" target="_blank" rel="noopener">LinkedIn</a>
        <a href={site.resume} class="link" target="_blank">Résumé (PDF)</a>
      </div>
    </footer>
  </body>
</html>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .top__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    height: 64px;
  }

  .top__name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    gap: clamp(16px, 3vw, 32px);
    font-size: 15px;
  }

  nav a {
    color: var(--muted);
    transition: color 0.2s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  @media (max-width: 420px) {
    nav {
      gap: 14px;
      font-size: 14px;
    }
  }

  .footer {
    margin-top: clamp(96px, 12vw, 160px);
    padding-bottom: 32px;
  }

  .footer__main {
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .footer__lead {
    font-size: clamp(22px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .footer__email {
    display: inline-block;
    margin-top: 6px;
    font-size: clamp(22px, 2.6vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .footer__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 56px;
    font-size: 14px;
  }
</style>
