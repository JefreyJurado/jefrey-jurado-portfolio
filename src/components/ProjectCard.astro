---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  group: string;
  title: string;
  category: string;
  client: string;
  year: string;
  cover: ImageMetadata;
  index: number;
}

const { slug, group, title, category, client, year, cover, index } = Astro.props;
---

<a href={`/work/${slug}/`} class="card" data-group={group}>
  <div class="card__well">
    <Image
      src={cover}
      alt={`${title} — ${category}`}
      widths={[400, 700, 1000]}
      sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw"
      loading={index < 3 ? 'eager' : 'lazy'}
    />
  </div>
  <p class="kicker">{category}</p>
  <h3>{title}</h3>
  <p class="card__meta">{client} · {year}</p>
</a>

<style>
  .card {
    display: block;
  }

  .card__well {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    aspect-ratio: 5 / 4;
    padding: clamp(16px, 7%, 36px);
    margin-bottom: 14px;
    background: var(--well);
    overflow: hidden;
  }

  .card__well img {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    outline: 1px solid rgba(0, 0, 0, 0.08);
    transition: transform 0.4s ease;
  }

  .card:hover .card__well img {
    transform: translateY(-4px);
  }

  h3 {
    margin: 6px 0 6px;
    font-size: clamp(26px, 2.4vw, 32px);
  }

  .card:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .card__meta {
    font-style: italic;
    font-size: 16px;
    color: var(--muted);
  }
</style>
