---
import { Image } from 'astro:assets';
import type { WorkImage } from '../data/projects';
import type { CardSize } from '../lib/layout';

interface Props {
  slug: string;
  group: string;
  title: string;
  category: string;
  year: string;
  images: WorkImage[];
  size: CardSize;
  index: number;
}

const { slug, group, title, category, year, images, size, index } = Astro.props;
const [cover, ...more] = images;
// Full-width cards show up to three pieces side by side.
const extras = more.slice(0, 2);
---

<a
  href={`/work/${slug}/`}
  class="card"
  data-group={group}
  data-size={size}
  style={`--tint: ${cover.tint}; --count: ${1 + extras.length}`}
>
  <div class="card__well">
    <Image
      src={cover.img}
      alt={cover.alt}
      widths={[500, 900, 1400]}
      sizes="(max-width: 760px) 100vw, 60vw"
      loading={index < 3 ? 'eager' : 'lazy'}
    />
    {
      extras.map((x) => (
        <Image
          src={x.img}
          alt={x.alt}
          class="card__extra"
          widths={[400, 700]}
          sizes="30vw"
          loading="lazy"
        />
      ))
    }
  </div>
  <div class="card__caption">
    <h3>{title}</h3>
    <span class="muted">{category} · {year}</span>
  </div>
</a>

<style>
  .card {
    display: block;
    grid-column: span 12;
  }

  .card[data-size='big'] {
    grid-column: span 7;
  }

  .card[data-size='small'] {
    grid-column: span 5;
  }

  .card__well {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    gap: 4%;
    aspect-ratio: 4 / 3;
    padding: clamp(24px, 7%, 64px);
    position: relative;
    background: var(--tint);
    border-radius: 20px;
    overflow: hidden;
    transition: background 0.3s;
  }

  /* "View project" pill that slides in on hover */
  .card__well::after {
    content: 'View project →';
    position: absolute;
    right: 16px;
    bottom: 16px;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--brand);
    color: var(--light);
    font-size: 14px;
    font-weight: 500;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s, transform 0.25s;
  }

  .card:hover .card__well::after,
  .card:focus-visible .card__well::after {
    opacity: 1;
    transform: none;
  }

  /* Both cards in a big/small pair share one height so their captions line up */
  .card[data-size='big'] .card__well,
  .card[data-size='small'] .card__well {
    aspect-ratio: auto;
    height: min(38vw, 560px);
  }

  .card[data-size='full'] .card__well {
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    aspect-ratio: 21 / 8;
    padding: clamp(24px, 4%, 56px) clamp(24px, 6%, 96px);
  }

  .card:hover .card__well {
    background: color-mix(in srgb, var(--tint) 93%, #000);
  }

  .card__well img {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08), 0 14px 36px -16px rgba(0, 0, 0, 0.35);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover .card__well img {
    transform: translateY(-6px);
  }

  .card__extra {
    display: none;
  }

  .card[data-size='full'] .card__extra {
    display: block;
  }

  .card__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 16px;
    padding: 16px 4px 0;
    font-size: 15px;
  }

  h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }

  .card:hover h3 {
    color: var(--brand);
  }

  @media (max-width: 760px) {
    .card[data-size] {
      grid-column: span 12;
    }
    .card[data-size] .card__well {
      grid-template-columns: minmax(0, 1fr);
      aspect-ratio: 4 / 3;
      height: auto;
    }
    .card[data-size] .card__extra {
      display: none;
    }
  }
</style>
