---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  group: string;
  title: string;
  category: string;
  year: string;
  cover: ImageMetadata;
  index: number;
}

const { slug, group, title, category, year, cover, index } = Astro.props;
---

<a href={`/work/${slug}/`} class="card" data-group={group}>
  <div class="card__well">
    <Image
      src={cover}
      alt={`${title} — ${category}`}
      widths={[500, 900, 1400]}
      sizes="(max-width: 760px) 100vw, 50vw"
      loading={index < 2 ? 'eager' : 'lazy'}
    />
  </div>
  <div class="card__caption">
    <h3>{title}</h3>
    <span class="muted">{category}, {year}</span>
  </div>
</a>

<style>
  .card {
    display: block;
  }

  .card__well {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: clamp(24px, 8%, 64px);
    background: var(--well);
    border-radius: 6px;
    overflow: hidden;
    transition: background 0.3s;
  }

  .card:hover .card__well {
    background: var(--well-hover);
  }

  .card__well img {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 12px 32px -16px rgba(0, 0, 0, 0.25);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .card:hover .card__well img {
    transform: scale(1.025);
  }

  .card__caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 16px;
    padding-top: 14px;
    font-size: 15px;
  }

  h3 {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
