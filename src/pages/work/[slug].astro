---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      number: i + 1,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, number, prev, next } = Astro.props;
const [hero, ...rest] = project.images;
const meta = [
  { label: 'Client', value: project.client },
  { label: 'Role', value: project.role },
  { label: 'Year', value: project.year },
  { label: 'Tools', value: project.tools.join(', ') },
];
---

<Base title={project.title} description={project.summary}>
  <article class="wrap">
    <div class="crumbs label">
      <a href="/#work" class="underline">← All work</a>
      <span>Project {number} of {projects.length}</span>
    </div>

    <header class="head">
      <p class="kicker">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="deck">{project.summary}</p>
    </header>

    <dl class="meta">
      {
        meta.map((m) => (
          <div>
            <dt class="label">{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="body">
      {project.description.map((para, i) => <p class:list={{ dropcap: i === 0 }}>{para}</p>)}
    </div>

    <figure class="fig fig--hero">
      <button class="zoom" data-full={hero.img.src} aria-label={`View full size: ${hero.caption}`}>
        <Image src={hero.img} alt={`${project.title} — ${hero.caption}`} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
      </button>
      <figcaption><span>Fig. 1</span> {hero.caption}</figcaption>
    </figure>

    {
      rest.length > 0 && (
        <div class="gallery">
          {rest.map((item, i) => (
            <figure class:list={['fig', { wide: item.img.width / item.img.height > 1.8 }]}>
              <button class="zoom" data-full={item.img.src} aria-label={`View full size: ${item.caption}`}>
                <Image
                  src={item.img}
                  alt={`${project.title} — ${item.caption}`}
                  widths={[600, 1000, 1600]}
                  sizes="(max-width: 720px) 100vw, 50vw"
                />
              </button>
              <figcaption>
                <span>Fig. {i + 2}</span> {item.caption}
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }

    <nav class="pager rule" aria-label="More projects">
      <a href={`/work/${prev.slug}/`}>
        <span class="label">← Previous</span>
        <span class="pager__title">{prev.title}</span>
      </a>
      <a href={`/work/${next.slug}/`} class="pager__next">
        <span class="label">Next →</span>
        <span class="pager__title">{next.title}</span>
      </a>
    </nav>
  </article>

  <dialog class="lightbox" aria-label="Image viewer">
    <img alt="" />
    <button class="lightbox__close" aria-label="Close">Close ✕</button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((btn) => {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.full!;
      img.alt = btn.querySelector('img')?.alt ?? '';
      dialog.showModal();
    });
  });
  dialog.addEventListener('click', () => dialog.close());
</script>

<style>
  .crumbs {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0 10px;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
  }

  .head {
    padding: clamp(32px, 6vw, 64px) 0 clamp(24px, 3vw, 36px);
    text-align: center;
  }

  .head h1 {
    margin: 12px 0 18px;
    font-size: clamp(52px, 9vw, 128px);
  }

  .deck {
    text-wrap: balance;
    max-width: 30em;
    margin: 0 auto;
    font-size: clamp(20px, 2vw, 25px);
    font-style: italic;
    line-height: 1.35;
    color: var(--muted);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 3px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  .meta div {
    padding: 12px 16px 14px 0;
  }

  .meta div + div {
    padding-left: 16px;
    border-left: 1px solid var(--hair);
  }

  .meta dd {
    margin: 4px 0 0;
    font-size: 17px;
    line-height: 1.35;
  }

  @media (max-width: 760px) {
    .meta {
      grid-template-columns: 1fr 1fr;
    }
    .meta div:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .meta div:nth-child(n + 3) {
      border-top: 1px solid var(--hair);
    }
  }

  .body {
    columns: 2 22em;
    column-gap: 40px;
    column-rule: 1px solid var(--hair);
    max-width: 960px;
    margin: 32px auto clamp(40px, 6vw, 64px);
  }

  .body p + p {
    margin-top: 1em;
  }

  .fig {
    margin: 0;
  }

  .zoom {
    display: grid;
    place-items: center;
    width: 100%;
    padding: clamp(16px, 4vw, 56px);
    border: 0;
    background: var(--well);
    cursor: zoom-in;
  }

  .zoom img {
    max-height: 80vh;
    width: auto;
    outline: 1px solid rgba(0, 0, 0, 0.08);
  }

  figcaption {
    padding: 8px 0 0;
    font-size: 15px;
    font-style: italic;
    color: var(--muted);
  }

  figcaption span {
    margin-right: 6px;
    font-family: var(--head);
    font-style: normal;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 36px clamp(16px, 2.4vw, 32px);
    margin-top: 36px;
  }

  .gallery .zoom {
    height: calc(100% - 32px);
  }

  .gallery .wide {
    grid-column: 1 / -1;
  }

  @media (max-width: 720px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(64px, 8vw, 96px);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 14px;
  }

  .pager__next {
    text-align: right;
    align-items: flex-end;
  }

  .pager__title {
    font-family: var(--head);
    font-stretch: 75%;
    font-weight: 800;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1;
  }

  .pager a:hover .pager__title {
    color: var(--spot);
  }

  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 0;
    background: rgba(20, 20, 20, 0.95);
    cursor: zoom-out;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 96px);
    width: auto;
  }

  .lightbox__close {
    position: fixed;
    top: 16px;
    right: 16px;
    padding: 10px 16px;
    border: 1px solid #666;
    background: transparent;
    color: #fff;
    font-family: var(--head);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
</style>
