---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const meta = [
  { label: 'Client', value: project.client },
  { label: 'Role', value: project.role },
  { label: 'Year', value: project.year },
  { label: 'Tools', value: project.tools.join(', ') },
];
---

<Base title={project.title} description={project.summary}>
  <article class="wrap">
    <header class="head">
      <a href="/#work" class="back muted">← All work</a>
      <p class="muted">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="summary">{project.summary}</p>
    </header>

    <div class="info">
      <dl class="meta">
        {
          meta.map((m) => (
            <div>
              <dt class="muted">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="description">
        {project.description.map((para) => <p>{para}</p>)}
      </div>
    </div>

    <div class="gallery">
      {
        project.images.map((item, i) => (
          <figure class:list={{ half: item.img.width / item.img.height < 1.15 }} style={`--tint: ${item.tint}`}>
            <button class="zoom" data-full={item.img.src} aria-label={`View full size: ${item.caption}`}>
              <Image
                src={item.img}
                alt={`${project.title} — ${item.caption}`}
                widths={[700, 1200, 2000]}
                sizes="(max-width: 760px) 100vw, 90vw"
                loading={i < 2 ? 'eager' : 'lazy'}
              />
            </button>
            <figcaption class="muted">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>

    <nav class="pager" aria-label="More projects">
      <a href={`/work/${prev.slug}/`}>
        <span class="muted">Previous</span>
        <span class="pager__title">{prev.title}</span>
      </a>
      <a href={`/work/${next.slug}/`} class="pager__next">
        <span class="muted">Next</span>
        <span class="pager__title">{next.title}</span>
      </a>
    </nav>
  </article>

  <dialog class="lightbox" aria-label="Image viewer">
    <img alt="" />
    <button class="lightbox__close" aria-label="Close">Close</button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
  const img = dialog.querySelector('img')!;
  document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((btn) => {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.full!;
      img.alt = btn.querySelector('img')?.alt ?? '';
      dialog.showModal();
    });
  });
  dialog.addEventListener('click', () => dialog.close());
</script>

<style>
  .head {
    padding: clamp(40px, 7vw, 96px) 0 clamp(32px, 4vw, 56px);
  }

  .back {
    display: inline-block;
    margin-bottom: clamp(32px, 5vw, 56px);
    font-size: 15px;
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--ink);
  }

  h1 {
    margin: 8px 0 16px;
    font-size: clamp(36px, 5.5vw, 76px);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .summary {
    max-width: 32em;
    font-size: clamp(18px, 1.6vw, 22px);
    color: var(--muted);
  }

  .info {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 32px clamp(32px, 6vw, 96px);
    padding: 32px 0 clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--line);
  }

  .meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 24px;
    margin: 0;
    align-content: start;
  }

  .meta dt {
    font-size: 14px;
  }

  .meta dd {
    margin: 2px 0 0;
  }

  .description {
    display: flex;
    flex-direction: column;
    gap: 1em;
    max-width: 40em;
    font-size: 17px;
  }

  @media (max-width: 860px) {
    .info {
      grid-template-columns: 1fr;
    }
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 4vw, 48px) clamp(16px, 2vw, 28px);
  }

  figure {
    grid-column: 1 / -1;
    margin: 0;
  }

  figure.half {
    grid-column: auto;
  }

  .zoom {
    display: grid;
    place-items: center;
    width: 100%;
    height: calc(100% - 34px);
    padding: clamp(20px, 5vw, 72px);
    border: 0;
    border-radius: 6px;
    background: var(--tint, var(--well));
    cursor: zoom-in;
  }

  .zoom img {
    max-height: 82vh;
    width: auto;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06), 0 16px 40px -20px rgba(0, 0, 0, 0.3);
  }

  figcaption {
    padding-top: 10px;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: clamp(72px, 9vw, 120px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 15px;
  }

  .pager__next {
    align-items: flex-end;
    text-align: right;
  }

  .pager__title {
    font-size: clamp(20px, 2.4vw, 32px);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .pager a:hover .pager__title {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 0;
    background: rgba(255, 255, 255, 0.97);
    cursor: zoom-out;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  .lightbox img {
    max-width: 100%;
    max-height: calc(100vh - 96px);
    width: auto;
  }

  .lightbox__close {
    position: fixed;
    top: 16px;
    right: 16px;
    padding: 9px 16px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
</style>
