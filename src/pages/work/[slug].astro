---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const meta = [
  { label: 'Client', value: project.client },
  { label: 'Role', value: project.role },
  { label: 'Year', value: project.year },
  { label: 'Tools', value: project.tools.join(', ') },
];
// Three equal columns when there are enough images to fill rows; two otherwise.
const columns = project.images.length >= 5 ? 3 : 2;
---

<Base title={project.title} description={project.summary}>
  <article class="wrap">
    <a href="/work/" class="back">← All work</a>

    <header class="head">
      <p class="head__tag">{project.category}</p>
      <h1>{project.title}</h1>
      <p class="head__summary">{project.summary}</p>
      <dl class="meta">
        {
          meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <section class="about">
      <h2>About the project</h2>
      <div class="about__text">
        {project.description.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <section aria-label="Project images">
      <div class="gallery__head">
        <h2>Gallery</h2>
        <span class="muted">{project.images.length} {project.images.length === 1 ? 'image' : 'images'} · click to enlarge</span>
      </div>
      <ul class="gallery" style={`--cols: ${columns}`}>
        {
          project.images.map((item, i) => (
            <li>
              <button
                class="tile"
                style={`--tint: ${item.tint}`}
                data-full={item.img.src}
                data-caption={item.caption}
                aria-label={`View full size: ${item.caption}`}
              >
                <Image
                  src={item.img}
                  alt={`${project.title} — ${item.caption}`}
                  widths={[400, 700, 1000]}
                  sizes={`(max-width: 640px) 100vw, (max-width: 1000px) 50vw, ${Math.round(100 / columns)}vw`}
                  loading={i < columns ? 'eager' : 'lazy'}
                />
              </button>
              <p class="tile__caption">
                <span>{String(i + 1).padStart(2, '0')}</span>
                {item.caption}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <nav class="pager" aria-label="More projects">
      {
        [
          { p: prev, label: '← Previous project' },
          { p: next, label: 'Next project →' },
        ].map(({ p, label }) => (
          <a href={`/work/${p.slug}/`} class="pager__card">
            <span class="pager__thumb" style={`--tint: ${p.images[0].tint}`}>
              <Image src={p.images[0].img} alt="" width={160} />
            </span>
            <span class="pager__text">
              <span class="muted">{label}</span>
              <span class="pager__title">{p.title}</span>
            </span>
          </a>
        ))
      }
    </nav>
  </article>

  <dialog class="viewer" aria-label="Image viewer">
    <figure class="viewer__figure">
      <img alt="" />
      <figcaption>
        <span class="viewer__count"></span>
        <span class="viewer__caption"></span>
      </figcaption>
    </figure>
    <button class="viewer__nav viewer__prev" aria-label="Previous image">←</button>
    <button class="viewer__nav viewer__next" aria-label="Next image">→</button>
    <button class="viewer__close" aria-label="Close">Close ✕</button>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.viewer')!;
  const img = dialog.querySelector('img')!;
  const count = dialog.querySelector('.viewer__count')!;
  const caption = dialog.querySelector('.viewer__caption')!;
  const tiles = [...document.querySelectorAll<HTMLButtonElement>('.tile')];
  let current = 0;

  const show = (i: number) => {
    current = (i + tiles.length) % tiles.length;
    const tile = tiles[current];
    img.src = tile.dataset.full!;
    img.alt = tile.querySelector('img')?.alt ?? '';
    count.textContent = `${current + 1} / ${tiles.length}`;
    caption.textContent = tile.dataset.caption ?? '';
  };

  tiles.forEach((tile, i) =>
    tile.addEventListener('click', () => {
      show(i);
      dialog.showModal();
    }),
  );

  dialog.querySelector('.viewer__prev')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('.viewer__next')!.addEventListener('click', () => show(current + 1));
  dialog.querySelector('.viewer__close')!.addEventListener('click', () => dialog.close());
  // Clicking the dark backdrop (not the image or buttons) closes the viewer.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as Element).classList.contains('viewer__figure')) dialog.close();
  });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  if (tiles.length < 2) dialog.querySelectorAll<HTMLElement>('.viewer__nav').forEach((b) => (b.hidden = true));
</script>

<style>
  .back {
    display: inline-block;
    margin: 20px 0 16px;
    font-size: 15px;
    color: var(--muted);
    transition: color 0.2s;
  }

  .back:hover {
    color: var(--accent);
  }

  /* Header card, same gradient as the rest of the site */
  .head {
    padding: clamp(32px, 4.5vw, 64px);
    border-radius: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(242, 242, 242, 0.12), transparent 55%),
      linear-gradient(135deg, var(--maroon) 0%, var(--wine) 100%);
    color: var(--light);
    box-shadow: 0 30px 60px -36px rgba(115, 3, 13, 0.6);
  }

  .head__tag {
    display: inline-block;
    padding: 5px 14px;
    border: 1px solid rgba(242, 242, 242, 0.35);
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.85);
  }

  h1 {
    margin: 18px 0 12px;
    font-size: clamp(40px, 5.6vw, 84px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .head__summary {
    max-width: 34em;
    font-size: clamp(17px, 1.5vw, 21px);
    color: rgba(242, 242, 242, 0.88);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: clamp(28px, 4vw, 44px) 0 0;
  }

  .meta div {
    padding: 16px 18px;
    background: var(--light);
    border-radius: 16px;
    color: var(--ink);
  }

  .meta dt {
    font-size: 13px;
    color: var(--muted);
  }

  .meta dd {
    margin: 4px 0 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
  }

  @media (max-width: 860px) {
    .meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .about {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: 16px clamp(24px, 5vw, 72px);
    margin: 20px 0 clamp(48px, 6vw, 72px);
    padding: clamp(28px, 4vw, 48px);
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 20px 50px -36px rgba(13, 13, 13, 0.4);
  }

  h2 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1em;
    max-width: 44em;
    font-size: 17px;
    color: var(--muted);
  }

  .about__text p:first-child {
    font-size: 19px;
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  /* Even gallery: every image gets an identical tile */
  .gallery__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-bottom: 18px;
    font-size: 15px;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1000px) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .tile {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 1;
    padding: 10%;
    border: 0;
    border-radius: 20px;
    background: var(--tint);
    cursor: zoom-in;
    transition: background 0.3s, transform 0.3s;
  }

  .tile:hover {
    background: color-mix(in srgb, var(--tint) 93%, #000);
    transform: translateY(-3px);
  }

  .tile img {
    width: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08), 0 14px 32px -16px rgba(0, 0, 0, 0.35);
  }

  .tile__caption {
    display: flex;
    gap: 10px;
    padding: 12px 4px 0;
    font-size: 15px;
  }

  .tile__caption span {
    font-variant-numeric: tabular-nums;
    color: var(--maroon);
  }

  /* Previous / next project cards */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(56px, 7vw, 88px);
  }

  .pager__card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 16px;
    background: #ffffff;
    border-radius: 22px;
    box-shadow: 0 20px 50px -36px rgba(13, 13, 13, 0.4);
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .pager__card:last-child {
    flex-direction: row-reverse;
    text-align: right;
  }

  .pager__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 26px 56px -34px rgba(115, 3, 13, 0.45);
  }

  .pager__thumb {
    display: grid;
    place-items: center;
    flex: none;
    width: 88px;
    height: 88px;
    padding: 10px;
    border-radius: 14px;
    background: var(--tint);
  }

  .pager__thumb img {
    max-height: 100%;
    width: auto;
  }

  .pager__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    font-size: 14px;
  }

  .pager__title {
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .pager__card:hover .pager__title {
    color: var(--maroon);
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }

  /* Full-size image viewer */
  .viewer {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(13, 13, 13, 0.94);
    color: var(--light);
  }

  .viewer[open] {
    display: grid;
    place-items: center;
  }

  .viewer__figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 64px clamp(16px, 8vw, 96px) 24px;
  }

  .viewer__figure img {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    width: auto;
    border-radius: 4px;
  }

  .viewer__figure figcaption {
    display: flex;
    gap: 14px;
    font-size: 15px;
  }

  .viewer__count {
    color: rgba(242, 242, 242, 0.6);
    font-variant-numeric: tabular-nums;
  }

  .viewer__nav,
  .viewer__close {
    position: fixed;
    border: 1px solid rgba(242, 242, 242, 0.3);
    border-radius: 999px;
    background: rgba(13, 13, 13, 0.6);
    color: var(--light);
    font: inherit;
    cursor: pointer;
    transition: background 0.2s;
  }

  .viewer__nav:hover,
  .viewer__close:hover {
    background: var(--maroon);
    border-color: var(--maroon);
  }

  .viewer__nav {
    top: 50%;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    font-size: 20px;
  }

  .viewer__prev {
    left: clamp(8px, 2vw, 24px);
  }

  .viewer__next {
    right: clamp(8px, 2vw, 24px);
  }

  .viewer__close {
    top: 16px;
    right: 16px;
    padding: 9px 16px;
    font-size: 14px;
  }
</style>
