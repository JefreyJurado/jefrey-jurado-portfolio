---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, featured, moreWork, groups } from '../../data/projects';
import { sizesFor } from '../../lib/layout';

const sections = [
  { id: 'featured', title: 'Featured', items: featured },
  { id: 'more', title: 'More work', items: moreWork },
].filter((s) => s.items.length > 0);
const filters = Object.entries(groups)
  .map(([key, label]) => ({ key, label, count: projects.filter((p) => p.group === key).length }))
  .filter((f) => f.count > 0);
---

<Base title="Work" description="Selected work by Jefrey Jurado: newspapers, magazines, packaging, logos and social media.">
  <section class="wrap work">
    <header class="head">
      <div>
        <p class="head__tag">Work</p>
        <h1>Selected work</h1>
        <p class="head__sub">
          Newspapers, magazines, packaging, logos, social media and print, from 12 years of client and in-house work.
        </p>
      </div>
      <dl class="head__stats">
        <div><dt>Projects</dt><dd>{projects.length}</dd></div>
        <div><dt>Categories</dt><dd>{filters.length}</dd></div>
      </dl>
    </header>

    <div class="bar">
      <div class="filters" role="group" aria-label="Filter projects">
        <button type="button" class="filter" data-filter="all" aria-pressed="true">
          All <span>{projects.length}</span>
        </button>
        {
          filters.map((f) => (
            <button type="button" class="filter" data-filter={f.key} aria-pressed="false">
              {f.label} <span>{f.count}</span>
            </button>
          ))
        }
      </div>
    </div>

    {
      sections.map((section) => {
        const sizes = sizesFor(section.items.length);
        return (
          <section class="group" aria-labelledby={`group-${section.id}`}>
            <div class="group__head">
              <h2 id={`group-${section.id}`}>{section.title}</h2>
              <span class="muted" data-count>
                {section.items.length} projects
              </span>
            </div>
            <div class="grid">
              {section.items.map((p, i) => (
                <ProjectCard
                  slug={p.slug}
                  group={p.group}
                  title={p.title}
                  category={p.category}
                  year={p.year}
                  images={p.images}
                  size={sizes[i]}
                  index={i}
                />
              ))}
            </div>
          </section>
        );
      })
    }
  </section>
</Base>

<script>
  import { sizesFor } from '../../lib/layout';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const groups = [...document.querySelectorAll<HTMLElement>('.group')];

  function apply(filter: string) {
    groups.forEach((group) => {
      const cards = [...group.querySelectorAll<HTMLElement>('[data-group]')];
      const visible = cards.filter((card) => filter === 'all' || card.dataset.group === filter);
      cards.forEach((card) => (card.hidden = !visible.includes(card)));
      // Re-flow the large/small rhythm for whichever cards are left, and hide a section left empty.
      sizesFor(visible.length).forEach((size, i) => (visible[i].dataset.size = size));
      group.hidden = visible.length === 0;
      group.querySelector('[data-count]')!.textContent =
        `${visible.length} ${visible.length === 1 ? 'project' : 'projects'}`;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    // Keep the choice in the URL so a filtered view can be shared, e.g. /work/?type=packaging
    const url = new URL(location.href);
    if (filter === 'all') url.searchParams.delete('type');
    else url.searchParams.set('type', filter);
    history.replaceState(null, '', url);
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));

  const initial = new URLSearchParams(location.search).get('type');
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>

<style>
  .work {
    padding-top: 12px;
  }

  /* Header card in the same brand gradient as the home page */
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 28px;
    padding: clamp(32px, 4.5vw, 64px);
    border-radius: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(242, 242, 242, 0.12), transparent 55%),
      linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
    color: var(--light);
    box-shadow: 0 30px 60px -36px rgba(var(--brand-rgb), 0.6);
  }

  .head__tag {
    display: inline-block;
    padding: 5px 14px;
    border: 1px solid rgba(242, 242, 242, 0.35);
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.85);
  }

  h1 {
    margin: 18px 0 12px;
    font-size: clamp(44px, 6vw, 88px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .head__sub {
    max-width: 34em;
    font-size: clamp(16px, 1.4vw, 19px);
    color: rgba(242, 242, 242, 0.85);
  }

  .head__stats {
    display: flex;
    gap: 12px;
    margin: 0;
  }

  .head__stats div {
    min-width: 120px;
    padding: 16px 20px;
    background: var(--light);
    border-radius: 16px;
    color: var(--ink);
  }

  .head__stats dt {
    font-size: 13px;
    color: var(--muted);
  }

  .head__stats dd {
    margin: 2px 0 0;
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--brand);
  }

  /* Filter pills, kept in view under the menu while scrolling */
  .bar {
    position: sticky;
    top: 64px;
    z-index: 5;
    margin: 20px 0 28px;
    padding: 10px 0;
    background: rgba(242, 242, 242, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .filters {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  /* On narrower screens the pills scroll sideways; fade the right edge so it's clear there are more */
  @media (max-width: 1100px) {
    .filters {
      padding-right: 40px;
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent);
    }
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
    color: var(--ink);
    font: inherit;
    font-size: 15px;
    white-space: nowrap;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }

  .filter span {
    min-width: 22px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--light);
    font-size: 12px;
    text-align: center;
    color: var(--muted);
  }

  .filter:hover {
    border-color: var(--brand);
  }

  .filter[aria-pressed='true'] {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--light);
  }

  .filter[aria-pressed='true'] span {
    background: rgba(242, 242, 242, 0.2);
    color: var(--light);
  }

  .group + .group {
    margin-top: clamp(64px, 8vw, 112px);
  }

  .group[hidden] {
    display: none;
  }

  .group__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 24px;
    padding: 0 4px;
  }

  h2 {
    font-size: clamp(24px, 2.4vw, 32px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) clamp(16px, 2vw, 28px);
  }

  .grid :global([hidden]) {
    display: none;
  }
</style>
