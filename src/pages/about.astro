---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const experience = [
  {
    role: 'Graphic Designer & Editor-in-Chief',
    org: 'The Southern Tagalog Herald Newspaper',
    years: '2019 – 2026',
    text: 'Ran weekly layout and production for three regional editions: 156 issues a year, with zero missed deadlines.',
  },
  {
    role: 'Packaging Designer & Brand Developer',
    org: "Noor's Gourmet Food · Freelance",
    years: '2021 – 2024',
    text: 'Packaging, product logos, calling cards and marketing collateral for multiple food lines.',
  },
  {
    role: 'Marketing Graphic Designer',
    org: 'AXA Insurance · Freelance',
    years: '2019 – 2021',
    text: 'Weekly social media posters and certificates over a two-year remote partnership.',
  },
  {
    role: 'Magazine Layout Designer',
    org: 'ASEAN Times Magazine · Contract',
    years: '2020',
    text: 'Monthly 36-page full-colour magazine layouts and Chinese-language newspaper pages.',
  },
  {
    role: 'Graphic Designer & Marketing Staff',
    org: 'KCD Technical Institute',
    years: '2018',
    text: 'Facebook enrollment campaigns, event photography and promotional videos.',
  },
  {
    role: 'Graphic Designer',
    org: 'Secular Male Institute of the Two Hearts',
    years: '2014 – 2023',
    text: 'Social media content, commemorative photo albums, newsletters, tarpaulins and event videos.',
  },
  {
    role: 'Graphic Designer',
    org: 'Monday Mail, The Barangay & Talahib Newspapers',
    years: '2014 – 2016',
    text: 'Weekly layouts for three newspapers running at the same time.',
  },
];

const services = [
  'Newspaper & editorial layout',
  'Magazine design',
  'Packaging & labels',
  'Logo design',
  'Social media graphics',
  'Photo albums & event coverage',
  'Print production & CTP prep',
];

const clients = [
  'The Southern Tagalog Herald',
  'AXA Insurance',
  'ASEAN Times Magazine',
  'PAPER.Ph',
  'BALWIK Magazine',
  "Noor's Gourmet Food",
  'KCD Technical Institute',
  'Institute of the Two Hearts',
  'Monday Mail',
];

const tools = [
  'Adobe InDesign',
  'Photoshop',
  'Illustrator',
  'Premiere Pro',
  'Canva',
  'HTML / CSS',
  'React & Next.js',
];
---

<Base title="About" description="About Jefrey Jurado, graphic designer and layout artist from Laguna, Philippines.">
  <div class="wrap">
    <section class="intro">
      <h1>
        I'm Jefrey, a graphic designer and layout artist from Laguna, Philippines.
      </h1>
      <div class="intro__body">
        <p>
          Most of my career has been in publishing. I've designed weekly newspapers, monthly magazines, and the
          legal and editorial pages in between, so I know how to make dense content clear and how to get files to
          the press on time. For the last seven years I ran layout for three regional editions of a weekly paper:
          156 issues a year, with no missed deadlines.
        </p>
        <p>
          Outside print, I've designed packaging for food brands, social media campaigns for insurance and
          education clients, logos for small businesses, and commemorative photo albums. I also studied IT
          (Software Development), so I'm comfortable working with web and app teams.
        </p>
        <p>I'm open to full-time roles and freelance projects, and willing to relocate.</p>
        <div class="actions">
          <a href={site.resume} class="btn btn--solid" target="_blank">Download résumé</a>
          <a href={`mailto:${site.email}`} class="btn">Get in touch</a>
        </div>
      </div>
    </section>

    <section class="row">
      <h2>Experience</h2>
      <ol class="jobs">
        {
          experience.map((e) => (
            <li>
              <div class="jobs__head">
                <h3>{e.role}</h3>
                <span class="muted">{e.years}</span>
              </div>
              <p class="muted">{e.org}</p>
              <p class="jobs__text">{e.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="row">
      <h2>Services</h2>
      <ul class="list">{services.map((s) => <li>{s}</li>)}</ul>
    </section>

    <section class="row">
      <h2>Clients</h2>
      <ul class="list">{clients.map((c) => <li>{c}</li>)}</ul>
    </section>

    <section class="row">
      <h2>Tools</h2>
      <ul class="list">{tools.map((t) => <li>{t}</li>)}</ul>
    </section>

    <section class="row">
      <h2>Education</h2>
      <ul class="edu">
        <li>
          <h3>BS Information Technology, Software Development</h3>
          <p class="muted">Mapúa Malayan Digital College · 2023 – 2026 (undergraduate)</p>
        </li>
        <li>
          <h3>BA in Communication</h3>
          <p class="muted">Mater Redemptoris College · 2010 – 2013</p>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px clamp(32px, 6vw, 96px);
    padding: clamp(56px, 10vw, 140px) 0 clamp(56px, 8vw, 112px);
  }

  h1 {
    font-size: clamp(30px, 3.4vw, 48px);
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .intro__body {
    display: flex;
    flex-direction: column;
    gap: 1em;
    font-size: 17px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
    }
  }

  /* Label on the left, content on the right */
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px clamp(32px, 6vw, 96px);
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
    }
  }

  .jobs,
  .list,
  .edu {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jobs li + li {
    margin-top: 28px;
  }

  .jobs__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  h3 {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .jobs__text {
    margin-top: 6px;
  }

  .list li {
    padding: 2px 0;
  }

  .edu li + li {
    margin-top: 20px;
  }
</style>
