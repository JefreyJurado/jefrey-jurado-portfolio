---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const experience = [
  {
    role: 'Graphic Designer & Editor-in-Chief',
    org: 'The Southern Tagalog Herald Newspaper',
    years: '2019 – 2026',
    text: 'Ran weekly layout and production for three regional editions: 156 issues a year, with zero missed deadlines.',
  },
  {
    role: 'Packaging Designer & Brand Developer',
    org: "Noor's Gourmet Food · Freelance",
    years: '2021 – 2024',
    text: 'Packaging, product logos, calling cards and marketing collateral for multiple food lines.',
  },
  {
    role: 'Marketing Graphic Designer',
    org: 'AXA Insurance · Freelance',
    years: '2019 – 2021',
    text: 'Weekly social media posters and certificates over a two-year remote partnership.',
  },
  {
    role: 'Magazine Layout Designer',
    org: 'ASEAN Times Magazine · Contract',
    years: '2020',
    text: 'Monthly 36-page full-colour magazine layouts and Chinese-language newspaper pages.',
  },
  {
    role: 'Graphic Designer & Marketing Staff',
    org: 'KCD Technical Institute',
    years: '2018',
    text: 'Facebook enrollment campaigns, event photography and promotional videos.',
  },
  {
    role: 'Graphic Designer',
    org: 'Secular Male Institute of the Two Hearts',
    years: '2014 – 2023',
    text: 'Social media content, commemorative photo albums, newsletters, tarpaulins and event videos.',
  },
  {
    role: 'Graphic Designer',
    org: 'Monday Mail, The Barangay & Talahib Newspapers',
    years: '2014 – 2016',
    text: 'Weekly layouts for three newspapers running at the same time.',
  },
];

const tools = [
  'Adobe InDesign',
  'Photoshop',
  'Illustrator',
  'Premiere Pro',
  'Canva',
  'CTP / print prep',
  'Colour management',
  'HTML / CSS',
  'React & Next.js',
];
---

<Base title="About" description="About Jefrey Jurado, graphic designer and layout artist from Laguna, Philippines.">
  <section class="wrap intro">
    <p class="label">About</p>
    <h1>
      Twelve years of <em>deadlines</em>, <br class="br-wide" />layouts and good typography.
    </h1>
    <div class="bio">
      <p>
        I'm a graphic designer and layout artist from Laguna, Philippines. Most of my career has been in
        publishing. I've designed weekly newspapers, monthly magazines and the legal and editorial pages in
        between, so I know how to make dense content clear and how to get files to the press on time.
      </p>
      <p>
        Outside print, I've designed packaging for food brands, social media campaigns for insurance and
        education clients, and commemorative photo albums for religious institutions. I also studied IT
        (Software Development), so I'm comfortable working with web and app teams.
      </p>
      <p>
        I'm open to <strong>full-time roles</strong> and <strong>freelance projects</strong>, and willing to relocate.
      </p>
      <div class="actions">
        <a href={site.resume} class="btn btn--solid" target="_blank">Download résumé (PDF)</a>
        <a href={`mailto:${site.email}`} class="btn">Email me</a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>Experience</h2>
      <span class="label">2014 — present</span>
    </div>
    <ol class="timeline">
      {
        experience.map((e) => (
          <li data-reveal>
            <span class="years">{e.years}</span>
            <div>
              <h3>{e.role}</h3>
              <p class="org">{e.org}</p>
            </div>
            <p class="text">{e.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section split">
    <div>
      <div class="section-head"><h2>Tools</h2></div>
      <ul class="chips">{tools.map((t) => <li>{t}</li>)}</ul>
    </div>
    <div>
      <div class="section-head"><h2>Education</h2></div>
      <ul class="edu">
        <li>
          <h3>BS Information Technology, Software Development</h3>
          <p>Mapúa Malayan Digital College · 2023 – 2026 (undergraduate)</p>
        </li>
        <li>
          <h3>BA in Communication</h3>
          <p>Mater Redemptoris College · 2010 – 2013</p>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(48px, 10vw, 128px);
  }

  h1 {
    margin: 16px 0 clamp(40px, 6vw, 72px);
    font-size: clamp(40px, 7vw, 104px);
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  h1 em {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .br-wide {
      display: none;
    }
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 1.1em;
    max-width: 40em;
    margin-left: auto;
    font-size: clamp(17px, 1.5vw, 20px);
  }

  .bio strong {
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  .section {
    padding-top: clamp(80px, 10vw, 140px);
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    grid-template-columns: 160px 1fr 1fr;
    gap: 8px 32px;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .years {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .timeline h3 {
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .org {
    margin-top: 4px;
    color: var(--muted);
  }

  .text {
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .timeline li {
      grid-template-columns: 1fr;
    }
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(48px, 6vw, 96px);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 15px;
  }

  .edu {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .edu h3 {
    font-size: 22px;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .edu p {
    margin-top: 6px;
    color: var(--muted);
  }
</style>
