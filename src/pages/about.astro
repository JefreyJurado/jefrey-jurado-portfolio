    text: 'Weekly layouts for three newspapers running at the same time.',
  },
];

const tools = [
  'Adobe InDesign',
  'Photoshop',
  'Illustrator',
  'Premiere Pro',
  'Canva',
  'CTP & print prep',
  'Colour management',
  'HTML / CSS',
  'React & Next.js',
