---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';

const facts = [
  { value: '12+', label: 'years in print & digital design' },
  { value: '156', label: 'newspaper issues laid out a year' },
  { value: '0', label: 'missed print deadlines' },
  { value: String(projects.length), label: 'portfolio projects to explore' },
];

// Small previews on the "See my work" card at the bottom of the page.
const previews = ['southern-tagalog-herald', 'balwik-magazine', 'noors-gourmet-food']
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);
---

<Base>
  <div class="wrap">
    <section class="hero">
      <div class="hero__about">
        <p class="hero__tag">About me</p>
        <h1>Jefrey Jurado</h1>
        <p class="hero__role">Graphic Designer &amp; Layout Artist · {site.location}</p>
        <p class="hero__bio">
          I've spent 12 years designing newspapers, magazines, packaging and social media content. Most recently I
          ran layout for three regional editions of a weekly newspaper: 156 issues a year, with no missed
          deadlines. I'm looking for a full-time design role, and I take on freelance projects.
        </p>
        <div class="hero__actions">
          <a href="/work/" class="hero__btn hero__btn--light">View my work →</a>
          <a href={site.resume} class="hero__btn" target="_blank">Download résumé</a>
          <a href={`mailto:${site.email}`} class="hero__btn">Email me</a>
        </div>
      </div>

      <div class="hero__side">
        <ul class="facts">
          {
            facts.map((f) => (
              <li>
                <span class="facts__value">{f.value}</span>
                <span class="facts__label">{f.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="hero__open">Open to full-time &amp; freelance work · willing to relocate</p>
      </div>
    </section>

    <section class="row">
      <h2>About</h2>
      <div class="prose">
        <p>
          Most of my career has been in publishing. I've designed weekly newspapers, monthly magazines, and the
          legal and editorial pages in between, so I know how to make dense content clear and how to get files to
          the press on time.
        </p>
        <p>
          Outside print, I've designed packaging for food brands, social media campaigns for insurance and
          education clients, logos for small businesses, and commemorative photo albums. I also studied IT
          (Software Development), so I'm comfortable working with web and app teams.
        </p>
      </div>
    </section>

    <a href="/work/" class="next">
      <span class="next__text">
        <span class="muted">Newspapers, magazines, packaging, logos and more</span>
        <span class="next__title">See my work →</span>
      </span>
      <span class="next__thumbs" aria-hidden="true">
        {
          previews.map((p) => (
            <span class="next__thumb" style={`--tint: ${p.images[0].tint}`}>
              <Image src={p.images[0].img} alt="" width={220} />
            </span>
          ))
        }
      </span>
    </a>
  </div>
</Base>

<style>
  /* Opening card: one maroon-to-wine gradient on the light page, with white fact cards */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    margin: 12px 0 clamp(56px, 8vw, 104px);
    padding: clamp(32px, 4.5vw, 64px);
    border-radius: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(242, 242, 242, 0.12), transparent 55%),
      linear-gradient(135deg, var(--maroon) 0%, var(--wine) 100%);
    color: var(--light);
    overflow: hidden;
    box-shadow: 0 30px 60px -36px rgba(115, 3, 13, 0.6);
  }

  .hero__about {
    display: flex;
    flex-direction: column;
  }

  .hero__tag {
    align-self: flex-start;
    padding: 6px 14px;
    border: 1px solid rgba(242, 242, 242, 0.35);
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.85);
  }

  h1 {
    margin: clamp(20px, 3vw, 36px) 0 10px;
    font-size: clamp(48px, 6vw, 92px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .hero__role {
    font-size: clamp(16px, 1.4vw, 19px);
    color: rgba(242, 242, 242, 0.78);
  }

  .hero__bio {
    max-width: 34em;
    margin-top: clamp(20px, 3vw, 32px);
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.55;
    color: rgba(242, 242, 242, 0.94);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: clamp(28px, 4vw, 44px);
  }

  .hero__btn {
    padding: 12px 20px;
    border: 1px solid rgba(242, 242, 242, 0.5);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .hero__btn:hover {
    background: rgba(242, 242, 242, 0.14);
    border-color: var(--light);
  }

  .hero__btn--light {
    background: var(--light);
    border-color: var(--light);
    color: var(--maroon);
  }

  .hero__btn--light:hover {
    background: #ffffff;
    border-color: #ffffff;
    transform: translateY(-1px);
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(18px, 2vw, 26px);
    background: var(--light);
    border-radius: 18px;
    color: var(--ink);
    box-shadow: 0 18px 36px -24px rgba(13, 13, 13, 0.55);
  }

  .facts__value {
    font-size: clamp(40px, 4.4vw, 64px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--maroon);
  }

  .facts__label {
    font-size: 14px;
    line-height: 1.35;
    color: var(--muted);
  }

  .hero__open {
    padding: 12px 16px;
    border-radius: 14px;
    background: rgba(242, 242, 242, 0.12);
    font-size: 14px;
    text-align: center;
    color: rgba(242, 242, 242, 0.9);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1em;
    max-width: 40em;
    font-size: 17px;
  }

  /* "See my work" card with three small previews */
  .next {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(28px, 4vw, 48px);
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 20px 50px -36px rgba(13, 13, 13, 0.4);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .next:hover {
    transform: translateY(-3px);
    box-shadow: 0 28px 60px -34px rgba(115, 3, 13, 0.45);
  }

  .next__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .next__title {
    font-size: clamp(30px, 3.6vw, 52px);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--maroon);
  }

  .next__thumbs {
    display: flex;
    gap: 12px;
  }

  .next__thumb {
    display: grid;
    place-items: center;
    width: clamp(84px, 10vw, 130px);
    aspect-ratio: 3 / 4;
    padding: 12px;
    background: var(--tint);
    border-radius: 14px;
    transition: transform 0.3s;
  }

  .next__thumb img {
    max-height: 100%;
    width: auto;
    box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.4);
  }

  .next:hover .next__thumb:nth-child(1) {
    transform: rotate(-4deg) translateY(-4px);
  }

  .next:hover .next__thumb:nth-child(3) {
    transform: rotate(4deg) translateY(-4px);
  }

  /* Label on the left, content on the right */
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px clamp(32px, 6vw, 96px);
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
  }

  h2 {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
