---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';

const facts = [
  { value: '12+', label: 'years in print & digital design' },
  { value: '156', label: 'newspaper issues laid out a year' },
  { value: '0', label: 'missed print deadlines' },
  { value: '3', label: 'regional newspaper editions every week' },
];

// Work shown in the opening card, so visitors see designs on the first screen.
// The first piece is the large tile; `image` picks which of the project's images to show.
const showcase = [
  { slug: 'southern-tagalog-herald', image: 0, label: 'Newspaper' },
  { slug: 'balwik-magazine', image: 0, label: 'Magazine' },
  { slug: 'noors-gourmet-food', image: 1, label: 'Packaging' },
].flatMap((s) => {
  const p = projects.find((p) => p.slug === s.slug);
  const item = p?.images[s.image] ?? p?.images[0];
  return p && item ? [{ ...s, project: p, item }] : [];
});

// Highlight tiles in the About section. Icons are simple 24px line drawings.
const strengths = [
  {
    title: 'Publishing',
    text: 'Weekly newspapers, monthly magazines and multi-page layouts, delivered print-ready.',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h4M7 16h4M14 12h3v4h-3z"/>',
  },
  {
    title: 'Packaging & brands',
    text: 'Labels, pouches and sacks for food products, plus the logos that go on them.',
    icon: '<path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  },
  {
    title: 'Digital',
    text: 'Social media campaigns and posts, with an IT background for working alongside web teams.',
    icon: '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  },
];

// Small previews on the "See my work" card at the bottom of the page.
const previews = ['paper-ph-magazine', 'logo-design', 'wgomez-rice']
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);
---

<Base>
  <div class="wrap">
    <section class="hero">
      <div class="hero__about">
        <p class="hero__tag">About me</p>
        <h1>Jefrey Jurado</h1>
        <p class="hero__role">Graphic Designer &amp; Layout Artist · {site.location}</p>
        <p class="hero__bio">
          I've spent 12 years designing newspapers, magazines, packaging and social media content. Today I run
          layout for three regional editions of a weekly newspaper: 156 issues a year, with no missed
          deadlines. I'm looking for a full-time design role, and I take on freelance projects.
        </p>
        <div class="hero__actions">
          <a href="/work/" class="hero__btn hero__btn--light">View my work →</a>
          <a href={site.resume} class="hero__btn" target="_blank">Download résumé</a>
          <a href={`mailto:${site.email}`} class="hero__btn">Email me</a>
        </div>
        <p class="hero__open">Open to full-time &amp; freelance work · willing to relocate</p>
      </div>

      <div class="showcase">
        {
          showcase.map((s, i) => (
            <a href={`/work/${s.project.slug}/`} class="showcase__item">
              <Image
                src={s.item.img}
                alt={`${s.project.title} — ${s.item.caption}`}
                widths={i === 0 ? [400, 640, 960] : [300, 480, 720]}
                sizes={i === 0 ? '(max-width: 900px) 55vw, 24vw' : '(max-width: 900px) 40vw, 18vw'}
                loading="eager"
                fetchpriority={i === 0 ? 'high' : 'auto'}
              />
              <span class="showcase__label">{s.label}</span>
            </a>
          ))
        }
      </div>
    </section>

    <ul class="facts">
      {
        facts.map((f) => (
          <li>
            <span class="facts__value">{f.value}</span>
            <span class="facts__label">{f.label}</span>
          </li>
        ))
      }
    </ul>

    <section class="about" aria-labelledby="about-title">
      <div class="about__head">
        <p class="about__tag">About</p>
        <h2 id="about-title">I make dense content clear, and I get it to the press on time.</h2>
      </div>
      <div class="about__body">
        <p class="about__lead">
          Most of my career has been in publishing. I've designed weekly newspapers, monthly magazines, and the
          legal and editorial pages in between, so I know how to make dense content clear and how to get files to
          the press on time.
        </p>
        <p>
          Outside print, I've designed packaging for food brands, social media campaigns for insurance and
          education clients, logos for small businesses, and commemorative photo albums. I also studied IT
          (Software Development), so I'm comfortable working with web and app teams.
        </p>
      </div>
      <ul class="strengths">
        {
          strengths.map((item) => (
            <li>
              <span class="strengths__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <Fragment set:html={item.icon} />
                </svg>
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <a href="/work/" class="next">
      <span class="next__text">
        <span class="muted">Newspapers, magazines, packaging, logos and more</span>
        <span class="next__title">See my work →</span>
      </span>
      <span class="next__thumbs" aria-hidden="true">
        {
          previews.map((p) => (
            <span class="next__thumb" style={`--tint: ${p.images[0].tint}`}>
              <Image src={p.images[0].img} alt="" width={220} />
            </span>
          ))
        }
      </span>
    </a>
  </div>
</Base>

<style>
  /* Opening card: one brand gradient on the light page, with white fact cards */
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(28px, 4vw, 56px);
    margin: 12px 0 16px;
    padding: clamp(32px, 4.5vw, 64px);
    border-radius: 28px;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(242, 242, 242, 0.12), transparent 55%),
      linear-gradient(135deg, var(--brand) 0%, var(--brand-2) 100%);
    color: var(--light);
    overflow: hidden;
    box-shadow: 0 30px 60px -36px rgba(var(--brand-rgb), 0.6);
  }

  .hero__about {
    display: flex;
    flex-direction: column;
  }

  .hero__tag {
    align-self: flex-start;
    padding: 6px 14px;
    border: 1px solid rgba(242, 242, 242, 0.35);
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(242, 242, 242, 0.85);
  }

  h1 {
    margin: clamp(20px, 3vw, 36px) 0 10px;
    font-size: clamp(48px, 6vw, 92px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .hero__role {
    font-size: clamp(16px, 1.4vw, 19px);
    color: rgba(242, 242, 242, 0.78);
  }

  .hero__bio {
    max-width: 34em;
    margin-top: clamp(20px, 3vw, 32px);
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.55;
    color: rgba(242, 242, 242, 0.94);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: auto;
    padding-top: clamp(28px, 4vw, 44px);
  }

  .hero__btn {
    padding: 12px 20px;
    border: 1px solid rgba(242, 242, 242, 0.5);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .hero__btn:hover {
    background: rgba(242, 242, 242, 0.14);
    border-color: var(--light);
  }

  .hero__btn--light {
    background: var(--light);
    border-color: var(--light);
    color: var(--brand);
  }

  .hero__btn--light:hover {
    background: #ffffff;
    border-color: #ffffff;
    transform: translateY(-1px);
  }

  /* Three real pieces of work: one tall tile on the left, two stacked on the right */
  .showcase {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 12px;
    min-height: clamp(380px, 38vw, 560px);
  }

  .showcase__item {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    background: var(--light);
    box-shadow: 0 22px 40px -22px rgba(13, 13, 13, 0.6);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .showcase__item:first-child {
    grid-row: 1 / -1;
  }

  .showcase__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 50px -24px rgba(13, 13, 13, 0.7);
  }

  .showcase__item img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .showcase__label {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 5px 11px;
    border-radius: 999px;
    background: rgba(13, 13, 13, 0.72);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--light);
  }

  /* Key numbers in a row of white cards under the opening card */
  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0 0 clamp(56px, 8vw, 104px);
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(18px, 2vw, 26px);
    background: #ffffff;
    border-radius: 18px;
    color: var(--ink);
    box-shadow: 0 20px 50px -36px rgba(13, 13, 13, 0.4);
  }

  .facts__value {
    font-size: clamp(40px, 4.4vw, 64px);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--brand);
  }

  .facts__label {
    font-size: 14px;
    line-height: 1.35;
    color: var(--muted);
  }

  .hero__open {
    margin-top: 18px;
    font-size: 14px;
    color: rgba(242, 242, 242, 0.75);
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .showcase {
      min-height: clamp(320px, 90vw, 520px);
    }
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
  }

  /* About section: headline and copy in a white card, with three strength tiles */
  .about {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(24px, 4vw, 64px);
    padding: clamp(28px, 4.5vw, 64px);
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 20px 50px -36px rgba(13, 13, 13, 0.4);
  }

  .about__tag {
    display: inline-block;
    padding: 5px 14px;
    border: 1px solid var(--brand);
    border-radius: 999px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .about h2 {
    margin-top: 20px;
    font-size: clamp(30px, 3.4vw, 50px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .about__body {
    display: flex;
    flex-direction: column;
    gap: 1em;
    padding-top: 6px;
    font-size: 17px;
    color: var(--muted);
  }

  .about__lead {
    font-size: clamp(19px, 1.6vw, 22px);
    line-height: 1.5;
    color: var(--ink);
  }

  .strengths {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: clamp(8px, 1.5vw, 16px) 0 0;
    padding: 0;
    list-style: none;
  }

  .strengths li {
    padding: 22px;
    background: var(--light);
    border-radius: 18px;
    transition: transform 0.25s, box-shadow 0.25s;
  }

  .strengths li:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 30px -22px rgba(var(--brand-rgb), 0.5);
  }

  .strengths__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand), var(--brand-2));
    color: var(--light);
  }

  .strengths__icon svg {
    width: 22px;
    height: 22px;
  }

  .strengths h3 {
    margin-bottom: 6px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .strengths p {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    .strengths {
      grid-template-columns: 1fr;
    }
  }

  /* "See my work" card with three small previews */
  .next {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: clamp(40px, 6vw, 72px);
    padding: clamp(28px, 4vw, 48px);
    background: #ffffff;
    border-radius: 24px;
    box-shadow: 0 20px 50px -36px rgba(13, 13, 13, 0.4);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .next:hover {
    transform: translateY(-3px);
    box-shadow: 0 28px 60px -34px rgba(var(--brand-rgb), 0.45);
  }

  .next__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .next__title {
    font-size: clamp(30px, 3.6vw, 52px);
    font-weight: 600;
    letter-spacing: -0.035em;
    color: var(--brand);
  }

  .next__thumbs {
    display: flex;
    gap: 12px;
  }

  .next__thumb {
    display: grid;
    place-items: center;
    width: clamp(84px, 10vw, 130px);
    aspect-ratio: 3 / 4;
    padding: 12px;
    background: var(--tint);
    border-radius: 14px;
    transition: transform 0.3s;
  }

  .next__thumb img {
    max-height: 100%;
    width: auto;
    box-shadow: 0 8px 18px -10px rgba(0, 0, 0, 0.4);
  }

  .next:hover .next__thumb:nth-child(1) {
    transform: rotate(-4deg) translateY(-4px);
  }

  .next:hover .next__thumb:nth-child(3) {
    transform: rotate(4deg) translateY(-4px);
  }

</style>
