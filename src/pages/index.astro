---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Hero from '../components/Hero.astro';
import { projects, groups } from '../data/projects';
import { sizesFor } from '../lib/layout';

const sizes = sizesFor(projects.length);
const filters = Object.entries(groups)
  .map(([key, label]) => ({ key, label, count: projects.filter((p) => p.group === key).length }))
  .filter((f) => f.count > 0);
---

<Base>
  <Hero />

  <section class="wrap work" id="work">
    <h2 class="work__title">Selected work</h2>
    <div class="filters" role="group" aria-label="Filter projects">
      <button type="button" class="filter" data-filter="all" aria-pressed="true">
        All <sup>{projects.length}</sup>
      </button>
      {
        filters.map((f) => (
          <button type="button" class="filter" data-filter={f.key} aria-pressed="false">
            {f.label} <sup>{f.count}</sup>
          </button>
        ))
      }
    </div>
    <div class="grid">
      {
        projects.map((p, i) => (
          <ProjectCard
            slug={p.slug}
            group={p.group}
            title={p.title}
            category={p.category}
            year={p.year}
            images={p.images}
            size={sizes[i]}
            index={i}
          />
        ))
      }
    </div>
  </section>
</Base>

<script>
  import { sizesFor } from '../lib/layout';

  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = [...document.querySelectorAll<HTMLElement>('.grid [data-group]')];

  function apply(filter: string) {
    const visible = cards.filter((card) => filter === 'all' || card.dataset.group === filter);
    cards.forEach((card) => (card.hidden = !visible.includes(card)));
    // Re-flow the large/small rhythm for whichever cards are left.
    sizesFor(visible.length).forEach((size, i) => (visible[i].dataset.size = size));
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
    // Keep the choice in the URL so a filtered view can be shared, e.g. /?type=packaging#work
    const url = new URL(location.href);
    if (filter === 'all') url.searchParams.delete('type');
    else url.searchParams.set('type', filter);
    history.replaceState(null, '', url);
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));

  // Quick links in the hero filter the grid in place instead of reloading the page.
  document.querySelectorAll<HTMLAnchorElement>('[data-jump]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      apply(a.dataset.jump!);
      document.getElementById('work')?.scrollIntoView({ behavior: 'smooth' });
    }),
  );

  const initial = new URLSearchParams(location.search).get('type');
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>

<style>
  .work {
    padding-top: clamp(56px, 7vw, 96px);
  }

  .work__title {
    margin-bottom: 18px;
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: -0.03em;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    margin-bottom: 28px;
  }

  .filter {
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: 15px;
    cursor: pointer;
    transition: color 0.2s;
  }

  .filter sup {
    font-size: 11px;
    margin-left: 1px;
  }

  .filter:hover,
  .filter[aria-pressed='true'] {
    color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) clamp(16px, 2vw, 28px);
  }

  .grid :global([hidden]) {
    display: none;
  }
</style>
